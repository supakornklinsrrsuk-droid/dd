--- =============================================
--- MAIN TAB
--- =============================================
MainTab:CreateSection("⚡ ฟังก์ชันช่วยเหลือ & เคลื่อนที่")

MainTab:CreateToggle({
   Name = "⚡ ออโต้ 'วาร์ป' ไปชุบเพื่อน (วาร์ปไปชุบทันที)",
   CurrentValue = false,
   Flag = "TpReviveToggle",
   Callback = function(Value)
      tpRevive = Value
      task.spawn(function()
         while tpRevive do
            pcall(function()
               for _, v in pairs(Workspace:GetDescendants()) do
                  if (v.Name == "Downed" or v.Name == "IsDowned" or v.Name == "Dead") and v.Value == true then
                     local character = v.Parent
                     if character and character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.5)
                     end
                  end
               end
            end)
            task.wait(0.2)
         end
      end)
   end,
})

MainTab:CreateToggle({
   Name = "🎯 วาร์ปไปหาเพื่อนที่รอดชีวิต",
   CurrentValue = false,
   Flag = "TpFriendToggle",
   Callback = function(Value)
      teleportToFriend = Value
      task.spawn(function()
         while teleportToFriend do
            pcall(function()
               for _, p in pairs(Players:GetPlayers()) do
                  if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                     local hum = p.Character:FindFirstChild("Humanoid")
                     if hum and hum.Health > 0 then
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                           LocalPlayer.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame + Vector3.new(3, 0, 3)
                           break
                        end
                     end
                  end
               end
            end)
            task.wait(2)
         end
      end)
   end,
})

