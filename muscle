-- ฟังก์ชันอัปเดตรายชื่อสัตว์เลี้ยง
local function updatePetList()
   myPetList = {}
   local backpack = game.Players.LocalPlayer:FindFirstChild("Backpack")
   local char = game.Players.LocalPlayer.Character
   
   local function scanFolder(folder)
      if folder then
         for _, item in pairs(folder:GetChildren()) do
            if item:IsA("Tool") or item:IsA("Folder") or item:IsA("Model") then
               table.insert(myPetList, item.Name)
            end
         end
      end
   end
   
   scanFolder(backpack)
   scanFolder(char)
   scanFolder(game.Players.LocalPlayer:FindFirstChild("petsFolder"))
   
   if #myPetList == 0 then
      myPetList = {"ไม่พบสัตว์เลี้ยง"}
   end
   return myPetList
end

updatePetList()

-- ฟังก์ชันวาร์ป
local function teleportTo(cframe)
   local char = game.Players.LocalPlayer.Character
   if char and char:FindFirstChild("HumanoidRootPart") then
      char.HumanoidRootPart.CFrame = cframe
   end
end

